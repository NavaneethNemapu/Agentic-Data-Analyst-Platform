# API Keys (Provide keys for any APIs you want to use)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here

# Default LLM Provider (options: auto, groq, ollama, openai, anthropic, gemini)
# 'auto' automatically detects and shifts to local Ollama if running, otherwise uses Groq API
DEFAULT_LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
GROQ_MODEL=openai/gpt-oss-120b

# Heterogeneous Multi-Agent Routing (Use different LLM APIs and models per agent)
# Providers: auto, groq, ollama, openai, anthropic, gemini
SCHEMA_LINKER_PROVIDER=groq
SCHEMA_LINKER_MODEL=openai/gpt-oss-20b

QUERY_PLANNER_PROVIDER=groq
QUERY_PLANNER_MODEL=openai/gpt-oss-20b

SQL_GENERATOR_PROVIDER=groq
SQL_GENERATOR_MODEL=openai/gpt-oss-120b

VALIDATOR_PROVIDER=groq
VALIDATOR_MODEL=openai/gpt-oss-120b

# Database Configuration (Connect PostgreSQL, MySQL, or SQLite)
TARGET_DB_URL=sqlite:///./data/target.db
SYSTEM_DB_URL=sqlite:///./data/system.db

# Redis/Celery
REDIS_URL=redis://localhost:6379/0

# FastAPI
SECRET_KEY=your-secret-key-here
